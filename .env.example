# Firebase Web App Config (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (Required for Firebase AI Logic)
# Production: reCAPTCHA Enterprise site key
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local Development only (register generated UUID in Firebase Console > App Check > Manage debug tokens)
# NEVER commit a real debug token to version control!
VITE_APP_CHECK_DEBUG_TOKEN=

# Optional override for Cloud Gemini 3 model (also configurable via Firebase Remote Config key: cloud_model_name)
VITE_CLOUD_MODEL=gemini-3-flash-preview
